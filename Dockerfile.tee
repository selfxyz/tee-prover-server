######## Enclave image ########

FROM public.ecr.aws/docker/library/rust:1.91-bookworm AS chef

# Pinned and --locked: this resolves cargo-chef's own dependency tree fresh on
# every image build (104 crates, no lockfile of ours involved), which is the
# one unpinned supply-chain surface left in this build. During the
# arrayref@0.3.10 window on 2026-08-20 a deploy ran at 07:55Z and those 104
# crates simply did not happen to include arrayref -- the app build was safe
# only because it uses --locked.
#
# It also makes the build reproducible, which matters more here than in most
# repos: the image digest IS the PCR0 attestation measurement, so an
# unpinned tool can change the measurement with no source change.
#
# 0.1.78 is the version the 2026-08-20 staging build resolved to. Bump
# deliberately, not implicitly.
RUN cargo install cargo-chef --locked --version 0.1.78

WORKDIR /src/

FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY src src/
RUN cargo chef prepare  --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /src/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json
COPY Cargo.toml Cargo.lock ./
COPY src src/

ARG PROOFTYPE=${PROOFTYPE}
# `chain` is always on: the enclave registers its own attested key via
# registerProverKey before the RPC server starts. With signature enforcement
# live on the hub, an image built without it serves proofs signed by a key no
# contract has ever seen, and every register call it produces is rejected.
RUN cargo build --locked --release --features $PROOFTYPE,chain

FROM debian:trixie

RUN apt-get update
RUN apt-get install build-essential cmake libgmp-dev libsodium-dev nasm curl m4 netcat-traditional socat iproute2 git jq unzip libc6 -y

# One Node install serves BOTH sidecars. Two separate RUN lines arrived here
# from independent branches -- the attestation JWT generator and the signature
# verifier -- and installing Node twice would just make the image larger and
# the layers harder to reason about.
#
# The two sidecars differ in one way that matters: jwt-input-generator has
# dependencies and needs `npm ci`, while signature-verifier/verify.mjs has
# zero dependencies by design, so copying the directory is sufficient.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && apt-get install -y nodejs

# The JWT attestation sidecar (src/attestation/bootstrap.rs spawns it via the
# installed tsx, with cwd /jwt/jwt-input-generator).
WORKDIR /jwt/jwt-input-generator
COPY jwt-input-generator/package*.json ./
RUN npm ci --omit=dev
COPY jwt-input-generator/ ./

WORKDIR /rapidsnark
COPY ./rapidsnark .
RUN ./build_gmp.sh host && \
    mkdir build_prover && cd build_prover && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=../package && \
    make -j16 && make install

ARG SIZE_FILTER=${SIZE_FILTER}
ARG PROOFTYPE=${PROOFTYPE}

COPY ./circuits/$PROOFTYPE/$SIZE_FILTER /circuits
COPY ./zkeys/$PROOFTYPE/$SIZE_FILTER /zkeys

# The attestation circuit is needed by every image variant (register/dsc/disclose,
# all sizes), so it's shipped unconditionally from a "common" category that
# sort_circuits.sh/sort_zkeys.sh never touch, instead of the filtered copies above.
COPY ./circuits/common/gcp_jwt_verifier_cpp /circuits/gcp_jwt_verifier_cpp
COPY ./zkeys/common/gcp_jwt_verifier.zkey /zkeys/gcp_jwt_verifier.zkey
RUN chmod +x /circuits/gcp_jwt_verifier_cpp/gcp_jwt_verifier

COPY --from=builder /src/target/release/tee-server /usr/local/bin/
RUN chmod +x /usr/local/bin/tee-server

COPY update_creds.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/update_creds.sh

COPY start.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/start.sh

COPY signature-verifier /signature-verifier

EXPOSE 8888
LABEL "tee.launch_policy.allow_env_override"="PROJECT_NUMBER,PROJECT_ID,POOL_NAME,SECRET_ID,PRECHECK_MODE,PROVER_SECRET_PREFIX"
LABEL "tee.launch_policy.monitoring_memory_allow"="always"

WORKDIR /usr/local/bin

CMD ["/usr/local/bin/start.sh"]